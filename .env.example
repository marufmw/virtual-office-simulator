# Copy to .env and fill in. .env is gitignored — real credentials never
# belong in the repository.

# Render gives two of these: use the internal URL when the app runs inside
# Render, and the external one (…​.oregon-postgres.render.com) from a laptop.
DATABASE_URL=postgresql://user:password@host/database

# Set when connecting to a Postgres that needs TLS but isn't a *.render.com
# hostname. Render's external URL turns this on by itself.
# DATABASE_SSL=true

# PORT=3001
