# Copy to .env and fill in. .env is gitignored — real credentials never
# belong in the repository.

# Render gives two of these: use the internal URL when the app runs inside
# Render, and the external one (…​.oregon-postgres.render.com) from a laptop.
DATABASE_URL=postgresql://user:password@host/database

# Set when connecting to a Postgres that needs TLS but isn't a *.render.com
# hostname. Render's external URL turns this on by itself.
# DATABASE_SSL=true

# --- Signing in ------------------------------------------------------------

# The OAuth *web application* client id from the Google Cloud console. Not a
# secret — it ships in the frontend bundle — and no client secret is needed:
# the browser gets an ID token and the server verifies it against Google's
# keys.
#
# Add these to "Authorized JavaScript origins" on that client:
#   http://localhost:5173                     (Vite, in development)
#   http://localhost:3001                     (the server, serving the build)
#   https://your-app.onrender.com             (production)
# Leave "Authorized redirect URIs" empty; this flow doesn't use them.
#
# Left unset, Google sign-in is off and a development door opens instead:
# type any email and you are that person. That door is refused outright when
# NODE_ENV=production.
GOOGLE_CLIENT_ID=

# What sessions are signed with. Unset, a new one is invented at startup,
# which signs everybody out on each restart — fine on a laptop, not in
# production. Any long random string will do:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PORT=3001
